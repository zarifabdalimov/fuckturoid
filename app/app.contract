// F*ckturoid: invoicing for phones.
// First launch: a landing screen, then the person's own details (the supplier
// block of every invoice; an IČO fills the rest from ARES), then two tabs:
// Invoices and Clients.
//
// This is the root: only it may declare resources, mutations, tasks, persisted
// state and routes, so it holds those and the actions that write them. Screens
// in src/screens/ draw, keep their own drafts where they can, and call back
// here with what to save. Shapes and the rules the screens need are in
// src/model/model.contract; app.ts answers the data with the rules in
// src/model/*.ts and the services in src/modules/.

use Company, Client, Item, Reply, FileReply, Invoice, Time, icoValid, reply, aresFound, clientOf, matches from "./src/model/model.contract"
use invoiceOf, noInvoice from "./src/model/model.contract"
use Welcome from "./src/screens/welcome.contract"
use InvoiceList, InvoiceDetail, InvoiceForm from "./src/screens/invoices.contract"
use Details from "./src/screens/details.contract"
use ClientList, ClientDetail, ClientForm from "./src/screens/clients.contract"
use Confirm from "./src/screens/confirm.contract"
use TabBar from "./src/screens/tab-bar.contract"

routes nav
  tab invoices "/"
    details "/details"
    invoice "/invoices/:id"
    editInvoice "/invoices/:id/edit"
    newInvoice "/new-invoice"
  tab clients "/clients"
    client "/clients/:id"
    editClient "/clients/:id/edit"
    newClient "/new-client"

component App
  // Your details: the supplier on every invoice. Persisted, so they live here.
  state onboarded = false persist
  state ico = "" persist
  state name = "" persist
  state dic = "" persist
  state street = "" persist
  state city = "" persist
  state zip = "" persist
  mutation looked as shape Company then afterLookup
  derive ares = reply(looked)
  derive canFinish = name.trim() != ""

  // Today, kept current by a tick: a day key ("2026-11-11") for due dates.
  resource time = exactTime() as shape Time
  state now = 0
  task tick mount
    every(60000, step)
  derive today = formatDate(time.epochAtZero + now, time.utcOffset, "iso")

  resource invoices = loadInvoices() as shape Invoice[] else empty()
  mutation invoiceSaved as shape Reply refreshes invoices then afterInvoiceSave
  mutation invoicePaidSaved as shape Reply refreshes invoices
  mutation invoiceRemoved as shape Reply refreshes invoices
  mutation pdfMade as shape FileReply then afterPdf
  derive pdfPath = match pdfMade { case some(r) => r.ok ? r.path : "", case none => "" }
  // The invoice the detail's Delete asks about.
  state aimedInvoice = ""

  resource clients = loadClients() as shape Client[] else empty()
  mutation clientLooked as shape Company then afterClientLookup
  mutation clientSaved as shape Reply refreshes clients then afterClientSave
  mutation clientRemoved as shape Reply refreshes clients
  derive cAres = reply(clientLooked)
  state query = ""
  derive shown = clients.filter(c => matches(c, query))
  // The client the detail's Delete asks about.
  state aimed = ""
  // The client sheet's drafts; cId is "" for a new client. They live here, not in
  // the sheet, because an ARES reply (which only the root receives) fills them.
  state cId = ""
  state cName = ""
  state cIco = ""
  state cDic = ""
  state cStreet = ""
  state cCity = ""
  state cZip = ""
  state cEmail = ""
  // The last Save's refusal, shown in red until a Save succeeds.
  state cRefusal = ""
  derive cSaveHint = pending(clientSaved) ? "Saving…" : cName.trim() == "" ? "Enter a name to save." : cIco != "" and not icoValid(cIco) ? "Fix the IČO or leave it empty to save." : ""

  mutation erased as shape Reply refreshes clients, invoices

  // Navigation.
  action step
    now = performanceNow()
  action pick(tab: string)
    nav = select(nav, tab)
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)

  // Your details: from the landing screen, and later from Invoices.
  action start
    nav = push(nav, "/details")
  action finish
    if canFinish
      onboarded = true
      nav = back(nav)
  action editIco(v: string)
    ico = v.trim()
    if icoValid(v.trim()) and not pending(looked)
      send looked = lookupIco(v.trim())
  action lookup
    if icoValid(ico) and not pending(looked)
      send looked = lookupIco(ico)
  action afterLookup
    if aresFound(ico, ares)
      name = ares.name
      dic = ares.dic
      street = ares.street
      city = ares.city
      zip = ares.zip
  action editName(v: string)
    name = v
  action editDic(v: string)
    dic = v.trim().toUpperCase()
  action editStreet(v: string)
    street = v
  action editCity(v: string)
    city = v
  action editZip(v: string)
    zip = v

  // Invoices. The sheet keeps its own drafts and hands over the finished invoice.
  action reloadInvoices
    refresh invoices
  action openAddInvoice
    nav = push(nav, "/new-invoice")
  action openEditInvoice(id: string)
    nav = push(nav, path("editInvoice", id))
  // The client and your details are copied into the invoice as they are now.
  action saveInvoice(id: string, clientId: string, issued: string, dueDays: number, items: Item[])
    if not pending(invoiceSaved)
      send invoiceSaved = saveInvoice(id, clientOf(clients, clientId), Client(id="me", name=name.trim(), ico=ico, dic=dic, street=street.trim(), city=city.trim(), zip=zip.trim(), email=""), issued, dueDays, items)
  action afterInvoiceSave
    if match invoiceSaved { case some(r) => r.ok, case none => false }
      if top(nav).name == "newInvoice" or top(nav).name == "editInvoice"
        nav = back(nav)
  // Share: the data module writes the PDF, then the share sheet offers it
  // (Save to Files, Mail, AirDrop, Print…).
  action sharePdf(id: string)
    if not pending(pdfMade)
      send pdfMade = makeInvoicePdf(id)
  action afterPdf
    if pdfPath != ""
      share(title=`Faktura ${invoiceOf(invoices, top(nav).params.id).number}`, files=[pdfPath])
  action setInvoicePaid(id: string, on: bool)
    send invoicePaidSaved = setInvoicePaid(id, on, formatDate(time.epochAtZero + performanceNow(), time.utcOffset, "iso"))
  action askRemoveInvoice(id: string)
    aimedInvoice = id
    showModal("remove-invoice")
  action removeInvoice(id: string)
    send invoiceRemoved = removeInvoice(id)
    if top(nav).name == "invoice" and top(nav).params.id == id
      nav = back(nav)

  // Clients.
  action search(v: string)
    query = v
  action reloadClients
    refresh clients
  action openAddClient
    clearClientDraft()
    nav = push(nav, "/new-client")
  // From an empty Invoices tab: over to Clients, with the add sheet open.
  action goAddClient
    clearClientDraft()
    nav = push(select(nav, "clients"), "/new-client")
  action clearClientDraft
    cId = ""
    cName = ""
    cIco = ""
    cDic = ""
    cStreet = ""
    cCity = ""
    cZip = ""
    cEmail = ""
    cRefusal = ""
  action openEditClient(id: string)
    let c = clientOf(clients, id)
    cId = c.id
    cName = c.name
    cIco = c.ico
    cDic = c.dic
    cStreet = c.street
    cCity = c.city
    cZip = c.zip
    cEmail = c.email
    cRefusal = ""
    nav = push(nav, path("editClient", id))
  action editCIco(v: string)
    cIco = v.trim()
    if icoValid(v.trim()) and not pending(clientLooked)
      send clientLooked = lookupIco(v.trim())
  action lookupClient
    if icoValid(cIco) and not pending(clientLooked)
      send clientLooked = lookupIco(cIco)
  action afterClientLookup
    if aresFound(cIco, cAres)
      cName = cAres.name
      cDic = cAres.dic
      cStreet = cAres.street
      cCity = cAres.city
      cZip = cAres.zip
  action editCName(v: string)
    cName = v
  action editCDic(v: string)
    cDic = v.trim().toUpperCase()
  action editCStreet(v: string)
    cStreet = v
  action editCCity(v: string)
    cCity = v
  action editCZip(v: string)
    cZip = v
  action editCEmail(v: string)
    cEmail = v.trim()
  action saveClient
    if cSaveHint == ""
      send clientSaved = saveClient(cId, cName.trim(), cIco, cDic, cStreet.trim(), cCity.trim(), cZip.trim(), cEmail)
  // The sheet closes only on an ok reply; a refusal keeps it open, saying why.
  action afterClientSave
    let refusal = match clientSaved { case some(r) => r.error, case none => "" }
    cRefusal = refusal
    if refusal == "" and (top(nav).name == "newClient" or top(nav).name == "editClient")
      nav = back(nav)
  action askRemoveClient(id: string)
    aimed = id
    showModal("remove-client")
  // A row's swipe deletes at once; the detail's Delete asks first, then leaves the detail.
  action removeClient(id: string)
    send clientRemoved = removeClient(id)
    if top(nav).name == "client" and top(nav).params.id == id
      nav = back(nav)

  // Log out: erase everything and start again at the landing screen.
  action askLogout
    showModal("logout")
  action logout
    send erased = eraseAll()
    onboarded = false
    ico = ""
    name = ""
    dic = ""
    street = ""
    city = ""
    zip = ""
    query = ""
    // Log Out is on Your details, over the Invoices tab: back is its landing screen.
    nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "invoices"
                if onboarded
                  InvoiceList(route=e.id, invoices=invoices, hasClients=(clients.length > 0), today=today,
                    loading=pending(invoices), broke=failed(invoices),
                    openDetails=start, add=openAddInvoice, addClient=goAddClient, reload=reloadInvoices)
                else
                  Welcome(route=e.id, start=start)
              if e.name == "details"
                Details(route=e.id, onboarded=onboarded, canFinish=canFinish,
                  ico=ico, name=name, dic=dic, street=street, city=city, zip=zip,
                  ares=ares, lookingUp=pending(looked), lookupFailed=failed(looked),
                  finish=finish, logout=askLogout, editIco=editIco, lookup=lookup, editName=editName, editDic=editDic,
                  editStreet=editStreet, editCity=editCity, editZip=editZip)
              if e.name == "invoice"
                InvoiceDetail(route=e.id, id=e.params.id, invoices=invoices, today=today, loading=pending(invoices),
                  edit=openEditInvoice(e.params.id), setPaid=setInvoicePaid(e.params.id),
                  share=sharePdf(e.params.id), sharing=pending(pdfMade),
                  askRemove=askRemoveInvoice(e.params.id), back=back)
              if e.name == "newInvoice"
                InvoiceForm(route=e.id, isNew=true, clients=clients, invoice=noInvoice(), today=today,
                  saving=pending(invoiceSaved), cancel=back, save=saveInvoice(""))
              if e.name == "editInvoice"
                // Made once the invoice has loaded, so its drafts start from it.
                for inv in invoices.filter(x => x.id == e.params.id) key=inv.id
                  InvoiceForm(route=e.id, isNew=false, clients=clients, invoice=inv, today=today,
                    saving=pending(invoiceSaved), cancel=back, save=saveInvoice(e.params.id))
              if e.name == "clients"
                ClientList(route=e.id, clients=clients, shown=shown, query=query,
                  loading=pending(clients), broke=failed(clients),
                  search=search, reload=reloadClients, add=openAddClient, remove=removeClient)
              if e.name == "client"
                ClientDetail(route=e.id, id=e.params.id, clients=clients, loading=pending(clients),
                  edit=openEditClient(e.params.id), askRemove=askRemoveClient(e.params.id), back=back)
              if e.name == "newClient" or e.name == "editClient"
                ClientForm(route=e.id, isNew=(e.name == "newClient"),
                  ico=cIco, name=cName, dic=cDic, street=cStreet, city=cCity, zip=cZip, email=cEmail,
                  refusal=cRefusal, ares=cAres, lookingUp=pending(clientLooked), lookupFailed=failed(clientLooked),
                  saveHint=cSaveHint, canSave=(cSaveHint == ""),
                  cancel=back, save=saveClient, editIco=editCIco, lookup=lookupClient, editName=editCName,
                  editDic=editCDic, editStreet=editCStreet, editCity=editCCity, editZip=editCZip, editEmail=editCEmail)

      TabBar(tab=nav.tab, shown=onboarded, pick=pick)

      Confirm(id="remove-client", title=`Delete ${clientOf(clients, aimed).name}?`,
        message="Their details will be gone. This can't be undone.", confirmLabel="Delete",
        confirm=removeClient(aimed), testPrefix="remove-client")
      Confirm(id="remove-invoice", title=`Delete invoice ${invoiceOf(invoices, aimedInvoice).number}?`,
        message="It will be gone for good. This can't be undone.", confirmLabel="Delete",
        confirm=removeInvoice(aimedInvoice), testPrefix="remove-invoice")
      Confirm(id="logout", title="Log out?",
        message="Your details, clients and invoices will be erased from this phone. This can't be undone.",
        confirmLabel="Log Out", confirm=logout, testPrefix="logout")
