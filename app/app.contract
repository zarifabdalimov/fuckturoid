use Company, Client, Item, Reply, FileReply, Invoice, Time, icoValid, reply, aresFound, clientOf, matches from "./src/model/model.contract"
use invoiceOf, noInvoice from "./src/model/model.contract"
use Welcome from "./src/screens/welcome.contract"
use InvoiceList, InvoiceDetail, InvoiceForm from "./src/screens/invoices.contract"
use Details from "./src/screens/details.contract"
use ClientList, ClientDetail, ClientForm from "./src/screens/clients.contract"
use Confirm from "./src/screens/confirm.contract"
use TabBar from "./src/screens/tab-bar.contract"

routes nav
  tab invoices "/"
    details "/details"
    invoice "/invoices/:id"
    editInvoice "/invoices/:id/edit"
    newInvoice "/new-invoice"
  tab clients "/clients"
    client "/clients/:id"
    editClient "/clients/:id/edit"
    newClient "/new-client"

component App
  state onboarded = false persist
  state ico = "" persist
  state name = "" persist
  state dic = "" persist
  state street = "" persist
  state city = "" persist
  state zip = "" persist
  state account = "" persist
  mutation looked as shape Company then afterLookup
  derive ares = reply(looked)
  derive canFinish = name.trim() != ""

  resource time = exactTime() as shape Time
  state now = 0
  task tick mount
    every(60000, step)
  derive today = formatDate(time.epochAtZero + now, time.utcOffset, "iso")

  resource invoices = loadInvoices() as shape Invoice[] else empty()
  mutation invoiceSaved as shape Reply refreshes invoices then afterInvoiceSave
  mutation invoicePaidSaved as shape Reply refreshes invoices
  mutation invoiceRemoved as shape Reply refreshes invoices
  mutation pdfMade as shape FileReply then afterPdf
  derive pdfPath = match pdfMade { case some(answer) => answer.ok ? answer.path : "", case none => "" }
  state aimedInvoice = ""

  resource clients = loadClients() as shape Client[] else empty()
  mutation clientLooked as shape Company then afterClientLookup
  mutation clientSaved as shape Reply refreshes clients then afterClientSave
  mutation clientRemoved as shape Reply refreshes clients
  derive cAres = reply(clientLooked)
  state query = ""
  derive shown = clients.filter(client => matches(client, query))
  state aimed = ""
  state cId = ""
  state cName = ""
  state cIco = ""
  state cDic = ""
  state cStreet = ""
  state cCity = ""
  state cZip = ""
  state cEmail = ""
  state cRefusal = ""
  derive cSaveHint = pending(clientSaved) ? "Saving…" : cName.trim() == "" ? "Enter a name to save." : cIco != "" and not icoValid(cIco) ? "Fix the IČO or leave it empty to save." : ""

  mutation erased as shape Reply refreshes clients, invoices

  action step
    now = performanceNow()
  action pick(tab: string)
    nav = select(nav, tab)
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)

  action start
    nav = push(nav, "/details")
  action finish
    if canFinish
      onboarded = true
      nav = back(nav)
  action editIco(value: string)
    ico = value.trim()
    if icoValid(value.trim()) and not pending(looked)
      send looked = lookupIco(value.trim())
  action lookup
    if icoValid(ico) and not pending(looked)
      send looked = lookupIco(ico)
  action afterLookup
    if aresFound(ico, ares)
      name = ares.name
      dic = ares.dic
      street = ares.street
      city = ares.city
      zip = ares.zip
  action editName(value: string)
    name = value
  action editDic(value: string)
    dic = value.trim().toUpperCase()
  action editStreet(value: string)
    street = value
  action editCity(value: string)
    city = value
  action editZip(value: string)
    zip = value
  action editAccount(value: string)
    account = value.replaceAll(" ", "")

  action reloadInvoices
    refresh invoices
  action openAddInvoice
    nav = push(nav, "/new-invoice")
  action openEditInvoice(id: string)
    nav = push(nav, path("editInvoice", id))
  action saveInvoice(id: string, clientId: string, issued: string, dueDays: number, items: Item[])
    if not pending(invoiceSaved)
      send invoiceSaved = saveInvoice(id, clientOf(clients, clientId), Client(id="me", name=name.trim(), ico=ico, dic=dic, street=street.trim(), city=city.trim(), zip=zip.trim(), email=""), issued, dueDays, items, account)
  action afterInvoiceSave
    if match invoiceSaved { case some(answer) => answer.ok, case none => false }
      if top(nav).name == "newInvoice" or top(nav).name == "editInvoice"
        nav = back(nav)
  action sharePdf(id: string)
    if not pending(pdfMade)
      send pdfMade = makeInvoicePdf(id)
  action afterPdf
    if pdfPath != ""
      share(title=`Faktura ${invoiceOf(invoices, top(nav).params.id).number}`, files=[pdfPath])
  action setInvoicePaid(id: string, on: bool)
    send invoicePaidSaved = setInvoicePaid(id, on, formatDate(time.epochAtZero + performanceNow(), time.utcOffset, "iso"))
  action askRemoveInvoice(id: string)
    aimedInvoice = id
    showModal("remove-invoice")
  action removeInvoice(id: string)
    send invoiceRemoved = removeInvoice(id)
    if top(nav).name == "invoice" and top(nav).params.id == id
      nav = back(nav)

  action search(value: string)
    query = value
  action reloadClients
    refresh clients
  action openAddClient
    clearClientDraft()
    nav = push(nav, "/new-client")
  action goAddClient
    clearClientDraft()
    nav = push(select(nav, "clients"), "/new-client")
  action clearClientDraft
    cId = ""
    cName = ""
    cIco = ""
    cDic = ""
    cStreet = ""
    cCity = ""
    cZip = ""
    cEmail = ""
    cRefusal = ""
  action openEditClient(id: string)
    let client = clientOf(clients, id)
    cId = client.id
    cName = client.name
    cIco = client.ico
    cDic = client.dic
    cStreet = client.street
    cCity = client.city
    cZip = client.zip
    cEmail = client.email
    cRefusal = ""
    nav = push(nav, path("editClient", id))
  action editCIco(value: string)
    cIco = value.trim()
    if icoValid(value.trim()) and not pending(clientLooked)
      send clientLooked = lookupIco(value.trim())
  action lookupClient
    if icoValid(cIco) and not pending(clientLooked)
      send clientLooked = lookupIco(cIco)
  action afterClientLookup
    if aresFound(cIco, cAres)
      cName = cAres.name
      cDic = cAres.dic
      cStreet = cAres.street
      cCity = cAres.city
      cZip = cAres.zip
  action editCName(value: string)
    cName = value
  action editCDic(value: string)
    cDic = value.trim().toUpperCase()
  action editCStreet(value: string)
    cStreet = value
  action editCCity(value: string)
    cCity = value
  action editCZip(value: string)
    cZip = value
  action editCEmail(value: string)
    cEmail = value.trim()
  action saveClient
    if cSaveHint == ""
      send clientSaved = saveClient(cId, cName.trim(), cIco, cDic, cStreet.trim(), cCity.trim(), cZip.trim(), cEmail)
  action afterClientSave
    let refusal = match clientSaved { case some(answer) => answer.error, case none => "" }
    cRefusal = refusal
    if refusal == "" and (top(nav).name == "newClient" or top(nav).name == "editClient")
      nav = back(nav)
  action askRemoveClient(id: string)
    aimed = id
    showModal("remove-client")
  action removeClient(id: string)
    send clientRemoved = removeClient(id)
    if top(nav).name == "client" and top(nav).params.id == id
      nav = back(nav)

  action askLogout
    showModal("logout")
  action logout
    send erased = eraseAll()
    onboarded = false
    ico = ""
    name = ""
    dic = ""
    street = ""
    city = ""
    zip = ""
    account = ""
    query = ""
    nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for tab in nav.tabs key=tab.name
          column role="tabpanel" id=`panel-${tab.name}` position="absolute" inset=0
            for entry in tab.stack key=entry.id
              if entry.name == "invoices"
                if onboarded
                  InvoiceList(route=entry.id, invoices=invoices, hasClients=(clients.length > 0), today=today,
                    loading=pending(invoices), broke=failed(invoices),
                    openDetails=start, add=openAddInvoice, addClient=goAddClient, reload=reloadInvoices)
                else
                  Welcome(route=entry.id, start=start)
              if entry.name == "details"
                Details(route=entry.id, onboarded=onboarded, canFinish=canFinish,
                  ico=ico, name=name, dic=dic, street=street, city=city, zip=zip, account=account,
                  ares=ares, lookingUp=pending(looked), lookupFailed=failed(looked),
                  finish=finish, logout=askLogout, editIco=editIco, lookup=lookup, editName=editName, editDic=editDic,
                  editStreet=editStreet, editCity=editCity, editZip=editZip, editAccount=editAccount)
              if entry.name == "invoice"
                InvoiceDetail(route=entry.id, id=entry.params.id, invoices=invoices, today=today, loading=pending(invoices),
                  edit=openEditInvoice(entry.params.id), setPaid=setInvoicePaid(entry.params.id),
                  share=sharePdf(entry.params.id), sharing=pending(pdfMade),
                  askRemove=askRemoveInvoice(entry.params.id), back=back)
              if entry.name == "newInvoice"
                InvoiceForm(route=entry.id, isNew=true, clients=clients, invoice=noInvoice(), today=today,
                  saving=pending(invoiceSaved), cancel=back, save=saveInvoice(""))
              if entry.name == "editInvoice"
                for inv in invoices.filter(candidate => candidate.id == entry.params.id) key=inv.id
                  InvoiceForm(route=entry.id, isNew=false, clients=clients, invoice=inv, today=today,
                    saving=pending(invoiceSaved), cancel=back, save=saveInvoice(entry.params.id))
              if entry.name == "clients"
                ClientList(route=entry.id, clients=clients, shown=shown, query=query,
                  loading=pending(clients), broke=failed(clients),
                  search=search, reload=reloadClients, add=openAddClient, remove=removeClient)
              if entry.name == "client"
                ClientDetail(route=entry.id, id=entry.params.id, clients=clients, loading=pending(clients),
                  edit=openEditClient(entry.params.id), askRemove=askRemoveClient(entry.params.id), back=back)
              if entry.name == "newClient" or entry.name == "editClient"
                ClientForm(route=entry.id, isNew=(entry.name == "newClient"),
                  ico=cIco, name=cName, dic=cDic, street=cStreet, city=cCity, zip=cZip, email=cEmail,
                  refusal=cRefusal, ares=cAres, lookingUp=pending(clientLooked), lookupFailed=failed(clientLooked),
                  saveHint=cSaveHint, canSave=(cSaveHint == ""),
                  cancel=back, save=saveClient, editIco=editCIco, lookup=lookupClient, editName=editCName,
                  editDic=editCDic, editStreet=editCStreet, editCity=editCCity, editZip=editCZip, editEmail=editCEmail)

      TabBar(tab=nav.tab, shown=onboarded, pick=pick)

      Confirm(id="remove-client", title=`Delete ${clientOf(clients, aimed).name}?`,
        message="Their details will be gone. This can't be undone.", confirmLabel="Delete",
        confirm=removeClient(aimed), testPrefix="remove-client")
      Confirm(id="remove-invoice", title=`Delete invoice ${invoiceOf(invoices, aimedInvoice).number}?`,
        message="It will be gone for good. This can't be undone.", confirmLabel="Delete",
        confirm=removeInvoice(aimedInvoice), testPrefix="remove-invoice")
      Confirm(id="logout", title="Log out?",
        message="Your details, clients and invoices will be erased from this phone. This can't be undone.",
        confirmLabel="Log Out", confirm=logout, testPrefix="logout")
