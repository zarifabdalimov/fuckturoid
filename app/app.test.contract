test "the landing screen leads into the details"
  expect tree has "welcome"
  expect tree missing "home"
  tap "get-started"
  clock settle
  expect tree has "ico"

test "Done waits for a name, then lands home for good"
  tap "get-started"
  clock settle
  expect disabled "finish"
  expect text "finish-hint" == "Add your name to finish."
  type "name" "Jan Novák"
  expect enabled "finish"
  tap "finish"
  clock settle
  expect tree has "home"
  expect tree missing "welcome"
  reload
  expect tree has "home"
  expect tree missing "welcome"

test "home opens the details again, without Done"
  tap "get-started"
  clock settle
  type "name" "Jan Novák"
  tap "finish"
  clock settle
  tap "open-details"
  clock settle
  expect text "name" == "Jan Novák"
  expect tree missing "finish"

test "an empty form says what to do"
  tap "get-started"
  clock settle
  expect text "ico-hint" == "Enter your IČO and the rest fills in from ARES."
  expect disabled "lookup"

test "a short IČO and a wrong check digit are refused before asking ARES"
  tap "get-started"
  clock settle
  type "ico" "1234"
  expect text "ico-hint" == "An IČO has 8 digits."
  expect disabled "lookup"
  type "ico" "28888287"
  expect text "ico-hint" == "This isn't a valid IČO: its check digit doesn't match."
  expect disabled "lookup"

test "a valid IČO fills the details from ARES"
  tap "get-started"
  clock settle
  type "ico" "28888286"
  clock data
  expect text "name" == "STRV s.r.o."
  expect text "dic" == "CZ28888286"
  expect text "street" == "Rohanské nábřeží 678/23"
  expect text "city" == "Praha 8"
  expect text "zip" == "186 00"
  expect text "ico-hint" == "Filled in from ARES: STRV s.r.o."

test "ARES out of reach says so and keeps what was typed"
  tap "get-started"
  clock settle
  type "name" "Jan Novák"
  fail fetch "https://ares.gov.cz"
  type "ico" "28888286"
  clock data
  expect text "ico-hint" == "Couldn't reach ARES. Check your connection and try again."
  expect text "name" == "Jan Novák"
  pass fetch "https://ares.gov.cz"
  tap "lookup"
  clock data
  expect text "name" == "STRV s.r.o."

test "details survive a relaunch"
  tap "get-started"
  clock settle
  type "name" "Jan Novák"
  type "city" "Brno"
  reload
  tap "get-started"
  clock settle
  expect text "name" == "Jan Novák"
  expect text "city" == "Brno"

test "a client is added by IČO, refused twice, edited and deleted"
  tap "get-started"
  clock settle
  type "name" "Jan Novák"
  tap "finish"
  clock settle
  tap "tab-clients"
  clock settle
  expect tree has "empty-add-client"
  tap "add-client"
  clock settle
  type "c-ico" "28888286"
  clock data
  expect text "c-name" == "STRV s.r.o."
  tap "client-save"
  clock data
  clock settle
  expect tree has "client-1"
  tap "add-client"
  clock settle
  type "c-ico" "28888286"
  clock data
  tap "client-save"
  clock data
  expect text "c-error" == "STRV s.r.o. already has this IČO."
  tap "client-cancel"
  clock settle
  tap "client-1"
  clock settle
  tap "edit-client"
  clock settle
  expect text "c-name" == "STRV s.r.o."
  type "c-email" "billing@strv.com"
  tap "client-save"
  clock data
  clock settle
  expect text "client-email" == "billing@strv.com"
  tap "delete-client"
  clock settle
  tap "remove-client-confirm"
  clock data
  clock settle
  expect tree has "empty-add-client"

test "Log Out asks, erases everything and returns to the landing screen"
  tap "get-started"
  clock settle
  type "name" "Jan Novák"
  tap "finish"
  clock settle
  tap "open-details"
  clock settle
  tap "logout"
  clock settle
  tap "logout-confirm"
  clock data
  clock settle
  expect tree has "welcome"
  tap "get-started"
  clock settle
  expect text "name" == ""
