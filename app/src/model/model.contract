shape Company
  ok: bool
  error: string
  ico: string
  name: string
  dic: string
  street: string
  city: string
  zip: string

shape Client
  id: string
  name: string
  ico: string
  dic: string
  street: string
  city: string
  zip: string
  email: string

shape Reply
  ok: bool
  error: string

fn digit(text: string, position: number): number = match parseNumber(text.slice(position, position + 1)) { case some(value) => value, case none => -100 }

fn icoSum(ico: string): number = digit(ico, 0) * 8 + digit(ico, 1) * 7 + digit(ico, 2) * 6 + digit(ico, 3) * 5 + digit(ico, 4) * 4 + digit(ico, 5) * 3 + digit(ico, 6) * 2

fn icoCheck(ico: string): number = icoSum(ico) % 11 == 0 ? 1 : icoSum(ico) % 11 == 1 ? 0 : 11 - icoSum(ico) % 11

fn icoValid(ico: string): bool = ico.length == 8 and icoSum(ico) >= 0 and digit(ico, 7) == icoCheck(ico)

fn icoBad(ico: string): bool = ico != "" and not icoValid(ico)

fn noCompany(): Company = Company(ok=false, error="", ico="", name="", dic="", street="", city="", zip="")

fn reply(answer: option<Company>): Company = match answer { case some(company) => company, case none => noCompany() }

fn aresFound(ico: string, answer: Company): bool = ico != "" and answer.ico == ico and answer.ok

fn icoMessage(ico: string, answer: Company, busy: bool, broke: bool): string = ico == "" ? "" : ico.length != 8 ? "An IČO has 8 digits." : not icoValid(ico) ? "This isn't a valid IČO: its check digit doesn't match." : busy ? "Looking it up in ARES…" : broke ? "Couldn't reach ARES. Check your connection and try again." : answer.ico == ico and answer.error != "" ? answer.error : aresFound(ico, answer) ? `Filled in from ARES: ${answer.name}` : ""

fn icoProblem(ico: string, answer: Company, broke: bool): bool = icoBad(ico) or broke or answer.ico == ico and answer.error != ""

fn noClient(): Client = Client(id="", name="", ico="", dic="", street="", city="", zip="", email="")

fn clientOf(clients: Client[], id: string): Client = match first(clients.filter(client => client.id == id)) { case some(client) => client, case none => noClient() }

fn found(clients: Client[], id: string): bool = clients.filter(client => client.id == id).length > 0

fn matches(client: Client, query: string): bool = client.name.toLowerCase().includes(query.trim().toLowerCase()) or client.ico.includes(query.trim()) or client.city.toLowerCase().includes(query.trim().toLowerCase())

fn clientLine(client: Client): string = [client.ico == "" ? "" : `IČO ${client.ico}`, client.city].filter(part => part != "").join(" · ")

shape Item
  description: string
  quantity: number
  unitPrice: number

shape Invoice
  id: string
  number: string
  issued: string
  due: string
  dueDays: number
  client: Client
  supplier: Client
  items: Item[]
  total: number
  paid: bool
  paidOn: string

shape DraftItem
  key: number
  description: string
  quantity: string
  price: string

shape FileReply
  ok: bool
  error: string
  path: string

shape Time
  epochAtZero: number
  utcOffset: number

fn blankItem(key: number): DraftItem = DraftItem(key=key, description="", quantity="1", price="")

fn amount(text: string): number = match parseNumber(text.trim().replaceAll(" ", "").replaceAll(",", ".")) { case some(value) => value, case none => -1 }

fn twoDigits(value: number): string = value < 10 ? `0${value}` : `${value}`

fn kc(hellers: number): string = `${formatNumber(floor(round(hellers) / 100), "decimal").replaceAll(",", " ")},${twoDigits(round(hellers) % 100)} Kč`

fn priceText(hellers: number): string = hellers % 100 == 0 ? `${hellers / 100}` : formatDecimal(hellers, 2).replaceAll(".", ",")

fn itemFilled(draft: DraftItem): bool = draft.description.trim() != "" or draft.price.trim() != ""

fn itemValid(draft: DraftItem): bool = draft.description.trim() != "" and amount(draft.quantity) > 0 and amount(draft.price) >= 0

fn itemHellers(draft: DraftItem): number = itemValid(draft) ? round(amount(draft.quantity) * round(amount(draft.price) * 100)) : 0

fn draftTotal(drafts: DraftItem[]): number = sum(drafts.map(draft => itemHellers(draft)))

fn toItem(draft: DraftItem): Item = Item(description=draft.description.trim(), quantity=amount(draft.quantity), unitPrice=round(amount(draft.price) * 100))

fn toDraft(item: Item, key: number): DraftItem = DraftItem(key=key, description=item.description, quantity=`${item.quantity}`, price=priceText(item.unitPrice))

fn czDate(iso: string): string = iso == "" ? "" : `${amount(iso.slice(8, 10))}. ${amount(iso.slice(5, 7))}. ${iso.slice(0, 4)}`

fn overdue(inv: Invoice, today: string): bool = not inv.paid and inv.due < today

fn noInvoice(): Invoice = Invoice(id="", number="", issued="", due="", dueDays=14, client=noClient(), supplier=noClient(), items=[], total=0, paid=false, paidOn="")

fn invoiceOf(invoices: Invoice[], id: string): Invoice = match first(invoices.filter(invoice => invoice.id == id)) { case some(invoice) => invoice, case none => noInvoice() }

fn invoiceFound(invoices: Invoice[], id: string): bool = invoices.filter(invoice => invoice.id == id).length > 0

fn idLine(client: Client): string = [client.ico == "" ? "" : `IČO ${client.ico}`, client.dic == "" ? "" : `DIČ ${client.dic}`].filter(part => part != "").join(" · ")
