shape Company
  ok: bool
  error: string
  ico: string
  name: string
  dic: string
  street: string
  city: string
  zip: string

shape Client
  id: string
  name: string
  ico: string
  dic: string
  street: string
  city: string
  zip: string
  email: string
  currency: string

shape Reply
  ok: bool
  error: string

fn digit(text: string, position: number): number = match parseNumber(text.slice(position, position + 1)) { case some(value) => value, case none => -100 }

fn icoSum(ico: string): number = digit(ico, 0) * 8 + digit(ico, 1) * 7 + digit(ico, 2) * 6 + digit(ico, 3) * 5 + digit(ico, 4) * 4 + digit(ico, 5) * 3 + digit(ico, 6) * 2

fn icoCheck(ico: string): number = icoSum(ico) % 11 == 0 ? 1 : icoSum(ico) % 11 == 1 ? 0 : 11 - icoSum(ico) % 11

fn icoValid(ico: string): bool = ico.length == 8 and icoSum(ico) >= 0 and digit(ico, 7) == icoCheck(ico)

fn icoBad(ico: string): bool = ico != "" and not icoValid(ico)

fn noCompany(): Company = Company(ok=false, error="", ico="", name="", dic="", street="", city="", zip="")

fn reply(answer: option<Company>): Company = match answer { case some(company) => company, case none => noCompany() }

fn aresFound(ico: string, answer: Company): bool = ico != "" and answer.ico == ico and answer.ok

fn icoMessage(ico: string, answer: Company, busy: bool, broke: bool): string = ico == "" ? "" : ico.length != 8 ? "An IČO has 8 digits." : not icoValid(ico) ? "This isn't a valid IČO: its check digit doesn't match." : busy ? "Looking it up in ARES…" : broke ? "Couldn't reach ARES. Check your connection and try again." : answer.ico == ico and answer.error != "" ? answer.error : aresFound(ico, answer) ? `Filled in from ARES: ${answer.name}` : ""

fn icoProblem(ico: string, answer: Company, broke: bool): bool = icoBad(ico) or broke or answer.ico == ico and answer.error != ""

fn noClient(): Client = Client(id="", name="", ico="", dic="", street="", city="", zip="", email="", currency="CZK")

fn clientOf(clients: Client[], id: string): Client = match first(clients.filter(client => client.id == id)) { case some(client) => client, case none => noClient() }

fn found(clients: Client[], id: string): bool = clients.filter(client => client.id == id).length > 0

fn matches(client: Client, query: string): bool = client.name.toLowerCase().includes(query.trim().toLowerCase()) or client.ico.includes(query.trim()) or client.city.toLowerCase().includes(query.trim().toLowerCase())

fn clientLine(client: Client): string = [client.ico == "" ? "" : `IČO ${client.ico}`, client.city].filter(part => part != "").join(" · ")

shape Item
  description: string
  quantity: number
  unitPrice: number

shape Invoice
  id: string
  number: string
  issued: string
  due: string
  dueDays: number
  client: Client
  supplier: Client
  items: Item[]
  total: number
  paid: bool
  paidOn: string
  account: string
  currency: string
  language: string
  iban: string
  bic: string
  bankName: string

shape DraftItem
  key: number
  description: string
  quantity: string
  price: string

shape FileReply
  ok: bool
  error: string
  path: string

shape Time
  epochAtZero: number
  utcOffset: number

fn blankItem(key: number): DraftItem = DraftItem(key=key, description="", quantity="", price="")

fn draftQuantity(draft: DraftItem): number = draft.quantity.trim() == "" ? 1 : amount(draft.quantity)

fn amount(text: string): number = match parseNumber(text.trim().replaceAll(" ", "").replaceAll(",", ".")) { case some(value) => value, case none => -1 }

fn twoDigits(value: number): string = value < 10 ? `0${value}` : `${value}`

fn currencySymbol(currency: string): string = currency == "EUR" ? "€" : currency == "USD" ? "$" : currency == "GBP" ? "£" : "Kč"

fn money(cents: number, currency: string): string = `${formatNumber(floor(round(cents) / 100), "decimal").replaceAll(",", " ")},${twoDigits(round(cents) % 100)} ${currencySymbol(currency)}`

fn priceText(hellers: number): string = hellers % 100 == 0 ? `${hellers / 100}` : formatDecimal(hellers, 2).replaceAll(".", ",")

fn itemFilled(draft: DraftItem): bool = draft.description.trim() != "" or draft.price.trim() != ""

fn itemValid(draft: DraftItem): bool = draft.description.trim() != "" and draftQuantity(draft) > 0 and amount(draft.price) >= 0

fn itemHellers(draft: DraftItem): number = itemValid(draft) ? round(draftQuantity(draft) * round(amount(draft.price) * 100)) : 0

fn draftTotal(drafts: DraftItem[]): number = sum(drafts.map(draft => itemHellers(draft)))

fn toItem(draft: DraftItem): Item = Item(description=draft.description.trim(), quantity=draftQuantity(draft), unitPrice=round(amount(draft.price) * 100))

fn toDraft(item: Item, key: number): DraftItem = DraftItem(key=key, description=item.description, quantity=`${item.quantity}`, price=priceText(item.unitPrice))

fn czDate(iso: string): string = iso == "" ? "" : `${amount(iso.slice(8, 10))}. ${amount(iso.slice(5, 7))}. ${iso.slice(0, 4)}`

fn overdue(inv: Invoice, today: string): bool = not inv.paid and inv.due < today

fn noInvoice(): Invoice = Invoice(id="", number="", issued="", due="", dueDays=14, client=noClient(), supplier=noClient(), items=[], total=0, paid=false, paidOn="", account="", currency="CZK", language="cs", iban="", bic="", bankName="")

fn invoiceOf(invoices: Invoice[], id: string): Invoice = match first(invoices.filter(invoice => invoice.id == id)) { case some(invoice) => invoice, case none => noInvoice() }

fn variableSymbol(number: string): string = number.split("").filter(char => "0123456789".includes(char)).join("")

fn languageName(language: string): string = language == "en" ? "English" : "Čeština"

fn invoiceFound(invoices: Invoice[], id: string): bool = invoices.filter(invoice => invoice.id == id).length > 0

fn idLine(client: Client): string = [client.ico == "" ? "" : `IČO ${client.ico}`, client.dic == "" ? "" : `DIČ ${client.dic}`].filter(part => part != "").join(" · ")

fn digitsOnly(text: string): bool = text != "" and text.split("").filter(char => not "0123456789".includes(char)).length == 0

fn digitFromRight(text: string, place: number): number = place < text.length ? amount(text.slice(text.length - 1 - place, text.length - place)) : 0

fn accountNumberSum(number: string): number = digitFromRight(number, 0) + digitFromRight(number, 1) * 2 + digitFromRight(number, 2) * 4 + digitFromRight(number, 3) * 8 + digitFromRight(number, 4) * 5 + digitFromRight(number, 5) * 10 + digitFromRight(number, 6) * 9 + digitFromRight(number, 7) * 7 + digitFromRight(number, 8) * 3 + digitFromRight(number, 9) * 6

fn accountPrefixSum(prefix: string): number = digitFromRight(prefix, 0) + digitFromRight(prefix, 1) * 2 + digitFromRight(prefix, 2) * 4 + digitFromRight(prefix, 3) * 8 + digitFromRight(prefix, 4) * 5 + digitFromRight(prefix, 5) * 10

fn accountBank(account: string): string = account.includes("/") ? account.slice(account.indexOf("/") + 1) : ""

fn accountMain(account: string): string = account.includes("/") ? account.slice(0, account.indexOf("/")) : account

fn accountPrefix(account: string): string = accountMain(account).includes("-") ? accountMain(account).slice(0, accountMain(account).indexOf("-")) : ""

fn accountNumber(account: string): string = accountMain(account).includes("-") ? accountMain(account).slice(accountMain(account).indexOf("-") + 1) : accountMain(account)

fn accountShapeOk(account: string): bool = accountBank(account).length == 4 and digitsOnly(accountBank(account)) and accountNumber(account).length >= 2 and accountNumber(account).length <= 10 and digitsOnly(accountNumber(account)) and (not accountMain(account).includes("-") or accountPrefix(account).length <= 6 and digitsOnly(accountPrefix(account)))

fn accountProblem(account: string): string = account == "" ? "" : not accountShapeOk(account) ? "Write it as 123456789/0800, or 19-123456789/0800 with a prefix." : accountNumberSum(accountNumber(account)) % 11 != 0 or accountPrefixSum(accountPrefix(account)) % 11 != 0 ? "Its check digits don't match. Look for a typo." : ""

shape BankAccount
  id: string
  account: string
  currency: string

fn accountFor(accounts: BankAccount[], currency: string): string = match first(accounts.filter(entry => entry.currency == currency)) { case some(entry) => entry.account, case none => "" }

fn noBankAccount(): BankAccount = BankAccount(id="", account="", currency="CZK")

fn bankAccountOf(accounts: BankAccount[], id: string): BankAccount = match first(accounts.filter(entry => entry.id == id)) { case some(entry) => entry, case none => noBankAccount() }

shape Created
  ok: bool
  error: string
  id: string

fn yearBefore(iso: string): string = `${amount(iso.slice(0, 4)) - 1}${iso.slice(4)}`

fn lastYear(invoices: Invoice[], today: string): Invoice[] = invoices.filter(invoice => invoice.issued > yearBefore(today) and invoice.issued <= today)

fn sumIn(invoices: Invoice[], currency: string): number = sum(invoices.filter(invoice => invoice.currency == currency).map(invoice => invoice.total))

fn amountsLine(invoices: Invoice[]): string = invoices.length == 0 ? money(0, "CZK") : ["CZK", "EUR", "USD", "GBP"].filter(currency => invoices.filter(invoice => invoice.currency == currency).length > 0).map(currency => money(sumIn(invoices, currency), currency)).join(" · ")

fn invoiceCount(count: number): string = count == 1 ? "1 invoice" : `${count} invoices`
