use Button from "../components/button.contract"

component Welcome
  props
    route: number
    start: action
  view
    column navigationKey=`${route}` navigationBar="none" position="absolute" inset=0 testId="welcome"
      color-scheme="dark" status-bar-style="light-content" background-color="hero.base"
      background-image="radial-gradient(120% 60% at 50% 0%, var(--hero.glow) 0%, transparent 70%), radial-gradient(110% 60% at 50% 100%, var(--hero.haze) 0%, transparent 70%), linear-gradient(180deg, var(--hero.top) 0%, var(--hero.base) 100%)"
      scroll flex=1 min-height=0
        column min-height="100%" box-sizing="border-box" padding="72px 28px 24px" justify-content="flex-start"
          align-items="center" text-align="center"
          image "assets/icon-1024.png" width=96 height=96 border-radius=22 aria-hidden=true testId="app-icon"
          text "F*ckturoid" role="heading" aria-level=1 font-size=46 font-weight=800 letter-spacing=-1
            color="hero.ink" margin-top=28
          text "Invoicing without the f*ckery." font-size=26 font-weight=700 color="hero.ink" margin-top=8
          text "Bill clients from your phone, get paid, and give zero f*cks about paperwork."
            font-size=17 color="hero.ink-soft" margin-top=12 max-width="22rem"
          column gap=14 margin-top=32 align-items="flex-start" text-align="start"
            Feature(symbol="symbol:sparkles", label="Fill in companies from ARES by IČO")
            Feature(symbol="symbol:document", label="Send PDF invoices in seconds")
            Feature(symbol="symbol:icon.bank", label="Bank details and IBAN on every invoice")
      column padding="12px 24px 20px" gap=12
        Button(label="Get started", variant="primary", size="large", trailingIcon="symbol:forward-chevron", disabled=false,
          press=start, buttonId="get-started")
        text "Free, no account. Your data stays on this phone." font-size=13 color="hero.ink-faint"
          text-align="center"

component Feature
  props
    symbol: string
    label: string
  view
    row gap=12 align-items="center"
      column width=32 height=32 border-radius=10 background-color="hero.glass" align-items="center"
        justify-content="center"
        image symbol color="hero.ink" aria-hidden=true
      text label font-size=16 font-weight=500 color="hero.ink"
