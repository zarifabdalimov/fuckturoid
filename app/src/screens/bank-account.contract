use EmptyState from "exact:content"
use BankAccount, accountProblem from "../model/model.contract"
use CurrencyChoice from "./currency-choice.contract"
use Button from "../components/button.contract"
use TextField from "../components/text-field.contract"
use FormSection from "../components/form-section.contract"

component BankAccountForm
  props
    route: number
    isNew: bool
    entry: BankAccount
    saving: bool
    cancel: action
    save: action
    remove: action
  state account = entry.account
  state currency = entry.currency
  derive problem = accountProblem(account)
  derive canSave = account != "" and problem == "" and not saving

  action editAccount(value: string)
    account = value.replaceAll(" ", "")
  action pickCurrency(value: string)
    currency = value
  action submit
    if canSave
      save(account, currency)

  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll=`bank-form-${route}` position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between"
        button id="back" press=cancel aria-label="Cancel" testId="bank-cancel"
          image "symbol:close"
        text (isNew ? "New Bank Account" : "Bank Account") role="heading"
        button press=submit buttonStyle="bordered-prominent" aria-label="Save" disabled=(not canSave) testId="bank-save"
          image "symbol:checkmark"
      scroll id=`bank-form-${route}` flex=1 min-height=0 keyboardDismissMode="on-drag" overflow-x="hidden"
        column padding="16px 20px 32px" gap=24 width="100%" box-sizing="border-box"
          TextField(label="Account number", value=account, placeholder="123456789/0800",
            hint=(problem != "" ? problem : "The Czech format: number/bank code, with a prefix if it has one."),
            hintTone=(problem != "" ? "error" : "muted"), invalid=(problem != ""), edit=editAccount, submit=submit,
            fieldId="bank-account", keyboard="text", autocomplete="off", autocapitalize="none", enterkeyhint="done",
            maxlength=24, autofocus=isNew)
          FormSection(title="Currency", footer=`Invoices in ${currency} are paid into this account.`, footerTone="muted")
            CurrencyChoice(value=currency, pick=pickCurrency, testPrefix="bank-currency")
          if not isNew
            Button(label="Delete Bank Account", variant="danger", size="large", leadingIcon="symbol:delete", trailingIcon="",
              disabled=false, press=remove, buttonId="bank-delete")

component BankAccountList
  props
    route: number
    bankAccounts: BankAccount[]
    loading: bool
    add: action
    remove: action
  view
    column navigationKey=`${route}` navigationScroll="bank-accounts-list" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center"
        text "Bank Accounts" role="heading" aria-level=2 flex=1
        button press=add aria-label="Add Bank Account" testId="add-bank-account"
          image "symbol:add"
      if bankAccounts.length == 0 and not loading
        EmptyState(symbol="symbol:icon.bank", title="No bank accounts yet", message="Add the accounts clients pay into, one for each currency you invoice in.")
          Button(label="Add Bank Account", variant="primary", size="small", leadingIcon="symbol:add", trailingIcon="",
            disabled=false, press=add, buttonId="empty-add-bank-account")
      else
        list id="bank-accounts-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
          section
            for entry in bankAccounts key=entry.id
              link href=path("editBankAccount", entry.id) delete=remove(entry.id) testId=`bank-${entry.id}`
                text entry.account flex=1 min-width=0
                text entry.currency color="-exact-secondary-label"
                image "symbol:forward-chevron"
            footer
              text "Clients pay into the account in their invoice's currency. Each goes on the invoice with its IBAN."
