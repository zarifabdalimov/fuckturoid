use Company, icoValid, icoMessage, icoProblem, aresFound from "../model/model.contract"
use TextField from "../components/text-field.contract"
use Button from "../components/button.contract"

component IcoSection
  props
    prefix: string
    label: string
    emptyHint: string
    ico: string
    reply: Company
    busy: bool
    broke: bool
    autofocus: bool
    edit: action
    lookup: action
  derive hint = ico == "" ? emptyHint : icoMessage(ico, reply, busy, broke)
  derive tone = icoProblem(ico, reply, broke) ? "error" : aresFound(ico, reply) ? "success" : "muted"
  view
    TextField(label=label, value=ico, placeholder="12345678", hint=hint, hintTone=tone, invalid=icoProblem(ico, reply, broke),
      edit=edit, submit=lookup, fieldId=`${prefix}ico`, keyboard="numeric", autocomplete="off", autocapitalize="none",
      enterkeyhint="search", maxlength=8, autofocus=autofocus)
      Button(label=(busy ? "Looking…" : "Fill in"), variant="primary", size="small", leadingIcon="", trailingIcon="",
        disabled=(not icoValid(ico) or busy), press=lookup, buttonId=`${prefix}lookup`)
