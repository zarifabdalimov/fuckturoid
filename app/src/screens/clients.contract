use EmptyState from "exact:content"
use Client, Company, clientOf, clientLine, found from "../model/model.contract"
use IcoSection from "./ico-section.contract"
use CurrencyChoice from "./currency-choice.contract"
use TextField from "../components/text-field.contract"
use Button from "../components/button.contract"
use FormSection from "../components/form-section.contract"

component ClientList
  props
    route: number
    clients: Client[]
    shown: Client[]
    query: string
    loading: bool
    broke: bool
    search: action
    reload: action
    add: action
    remove: action
  view
    column navigationKey=`${route}` navigationScroll="clients-list" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" flex-wrap="wrap" align-items="center" gap=8
        text "Clients" role="heading" aria-level=1 flex=1
        button press=add aria-label="Add Client" testId="add-client"
          image "symbol:add"
        if clients.length > 0
          input type="search" value=query input=search placeholder="Search" aria-label="Search Clients"
            testId="search-clients" width="100%"
      if broke
        EmptyState(symbol="symbol:alert", title="Can't Open Clients", message="Something went wrong reading them.")
          Button(label="Try Again", variant="primary", size="small", leadingIcon="", trailingIcon="",
            disabled=false, press=reload, buttonId="clients-retry")
      else if clients.length == 0 and not loading
        EmptyState(symbol="symbol:people", title="No Clients Yet", message="Add the people and companies you invoice. An IČO fills in the rest from ARES.")
          Button(label="Add Client", variant="primary", size="small", leadingIcon="symbol:add", trailingIcon="",
            disabled=false, press=add, buttonId="empty-add-client")
      else if shown.length == 0 and not loading
        EmptyState(symbol="symbol:search", title=`No Results for “${query.trim()}”`, message="Check the spelling or try a new search.")
      else
        list id="clients-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
          section
            for client in shown key=client.id
              link href=path("client", client.id) delete=remove(client.id) testId=`client-${client.id}`
                column flex=1 min-width=0 gap=3 padding-top=10 padding-bottom=10
                  text client.name
                  if clientLine(client) != ""
                    text clientLine(client) font="-exact-subheadline" color="-exact-secondary-label"
                image "symbol:forward-chevron"

component ClientDetail
  props
    route: number
    id: string
    clients: Client[]
    loading: bool
    edit: action
    askRemove: action
    back: action
  view
    column navigationKey=`${route}` navigationScroll=`client-${route}` position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center"
        text (found(clients, id) or loading ? clientOf(clients, id).name : "Not Found")
          role="heading" aria-level=2 testId="client-title"
        if found(clients, id)
          button press=edit testId="edit-client"
            text "Edit"
      if found(clients, id) or loading
        list id=`client-${route}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
          for client in clients.filter(candidate => candidate.id == id) key=client.id
            section
              row
                text "IČO"
                text (client.ico == "" ? "None" : client.ico) testId="client-ico"
              row
                text "DIČ"
                text (client.dic == "" ? "Not a VAT payer" : client.dic) testId="client-dic"
              row
                text "Currency"
                text client.currency testId="client-currency"
            section
              header
                text "Address"
              row padding-top=10 padding-bottom=10
                column flex=1 min-width=0 gap=2
                  if client.street == "" and client.city == "" and client.zip == ""
                    text "No address" color="-exact-secondary-label"
                  if client.street != ""
                    text client.street testId="client-street"
                  if client.zip != "" or client.city != ""
                    text [client.zip, client.city].filter(part => part != "").join(" ") testId="client-city"
            section
              header
                text "Email"
              row
                text (client.email == "" ? "No email" : client.email) color=(client.email == "" ? "-exact-secondary-label" : "-exact-label") testId="client-email"
            section
              button press=askRemove destructive=true testId="delete-client"
                text "Delete Client"
      else
        EmptyState(symbol="symbol:alert", title="No such client", message="They may have been deleted.")
          Button(label="Back to Clients", variant="primary", size="small", leadingIcon="", trailingIcon="",
            disabled=false, press=back, buttonId="missing-back")

component ClientForm
  props
    route: number
    isNew: bool
    ico: string
    name: string
    dic: string
    street: string
    city: string
    zip: string
    email: string
    currency: string
    refusal: string
    ares: Company
    lookingUp: bool
    lookupFailed: bool
    saveHint: string
    canSave: bool
    cancel: action
    save: action
    editIco: action
    lookup: action
    editName: action
    editDic: action
    editStreet: action
    editCity: action
    editZip: action
    editEmail: action
    pickCurrency: action
  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll=`client-form-${route}` position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between"
        button id="back" press=cancel aria-label="Cancel" testId="client-cancel"
          image "symbol:close"
        text (isNew ? "New Client" : "Edit Client") role="heading"
        button press=save buttonStyle="bordered-prominent" aria-label="Save" testId="client-save"
          disabled=(not canSave)
          image "symbol:checkmark"
      scroll id=`client-form-${route}` flex=1 min-height=0 keyboardDismissMode="on-drag" overflow-x="hidden"
        column padding="16px 20px 32px" gap=24 width="100%" box-sizing="border-box"
          IcoSection(prefix="c-", label="IČO", emptyHint="Type the client's IČO and the rest fills in from ARES.", ico=ico,
            reply=ares, busy=lookingUp, broke=lookupFailed, autofocus=isNew, edit=editIco, lookup=lookup)
          TextField(label="Name or company", value=name, placeholder="Acme s.r.o.", hint=refusal, hintTone="error",
            invalid=(refusal != ""), edit=editName, submit=save, fieldId="c-name", keyboard="text", autocomplete="organization",
            autocapitalize="words", enterkeyhint="done", maxlength=120, autofocus=false)
          TextField(label="DIČ", value=dic, placeholder="CZ12345678", hint="Optional.", hintTone="muted", invalid=false,
            edit=editDic, submit=save, fieldId="c-dic", keyboard="text", autocomplete="off", autocapitalize="characters",
            enterkeyhint="done", maxlength=14, autofocus=false)
          FormSection(title="Address", footer="", footerTone="muted")
            TextField(label="Street and number", value=street, placeholder="Rohanské nábřeží 678/23", hint="", hintTone="muted",
              invalid=false, edit=editStreet, submit=save, fieldId="c-street", keyboard="text", autocomplete="street-address",
              autocapitalize="words", enterkeyhint="done", maxlength=120, autofocus=false)
            row gap=12
              column flex=2 min-width=0
                TextField(label="City", value=city, placeholder="Praha 8", hint="", hintTone="muted", invalid=false,
                  edit=editCity, submit=save, fieldId="c-city", keyboard="text", autocomplete="address-level2",
                  autocapitalize="words", enterkeyhint="done", maxlength=80, autofocus=false)
              column flex=1 min-width=0
                TextField(label="ZIP", value=zip, placeholder="186 00", hint="", hintTone="muted", invalid=false,
                  edit=editZip, submit=save, fieldId="c-zip", keyboard="numeric", autocomplete="postal-code",
                  autocapitalize="none", enterkeyhint="done", maxlength=6, autofocus=false)
          TextField(label="Email", value=email, placeholder="billing@example.com", hint="Optional. Invoices can be sent here.",
            hintTone="muted", invalid=false, edit=editEmail, submit=save, fieldId="c-email", keyboard="email",
            autocomplete="email", autocapitalize="none", enterkeyhint="done", maxlength=120, autofocus=false)
          FormSection(title="Currency", footer="New invoices for this client start in this currency.", footerTone="muted")
            CurrencyChoice(value=currency, pick=pickCurrency, testPrefix="c-currency")
          if saveHint != ""
            text saveHint font-size=13 color="control.hint" testId="c-save-hint"
