component TabBar
  props
    tab: string
    shown: bool
    pick: action
  view
    row role="tablist" display=(shown ? "flex" : "none") testId="tabs"
      button role="tab" aria-controls="panel-invoices" aria-selected=(tab == "invoices") press=pick("invoices")
        testId="tab-invoices" flex=1
        image "symbol:document"
        text "Invoices"
      button role="tab" aria-controls="panel-clients" aria-selected=(tab == "clients") press=pick("clients")
        testId="tab-clients" flex=1
        image "symbol:people"
        text "Clients"
