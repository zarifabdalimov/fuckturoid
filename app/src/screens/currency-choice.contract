use Choice from "../model/model.contract"
use Segmented from "../components/segmented.contract"

component CurrencyChoice
  props
    value: string
    pick: action
    testPrefix: string
  view
    Segmented(label="Currency", choices=["CZK", "EUR", "USD", "GBP"].map(code => Choice(value=code, label=code)), value=value,
      pick=pick, testPrefix=testPrefix)
