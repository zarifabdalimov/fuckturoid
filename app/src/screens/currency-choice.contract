component CurrencyChoice
  props
    value: string
    pick: action
    testPrefix: string
  view
    row role="radiogroup" aria-label="Currency"
      for currency in ["CZK", "EUR", "USD", "GBP"] key=currency
        button role="radio" aria-checked=(value == currency) press=pick(currency) testId=`${testPrefix}-${currency}` flex=1
          text currency
