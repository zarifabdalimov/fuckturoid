use Badge, EmptyState from "exact:content"
use BankAccount, Client, Invoice, DraftItem, money, currencySymbol, accountFor, clientOf, czDate, overdue, invoiceOf, invoiceFound, idLine, itemHellers, itemValid, itemFilled from "../model/model.contract"
use Choice, StatItem, topRadius, bottomRadius, amount, blankItem, draftTotal, toItem, toDraft, lastYear, amountsLine, invoiceCount, variableSymbol, languageName from "../model/model.contract"
use CurrencyChoice from "./currency-choice.contract"
use Button from "../components/button.contract"
use TextField from "../components/text-field.contract"
use FormSection, FieldFrame from "../components/form-section.contract"
use Segmented from "../components/segmented.contract"

component InvoiceList
  props
    route: number
    invoices: Invoice[]
    hasClients: bool
    today: string
    loading: bool
    broke: bool
    openDetails: action
    add: action
    addClient: action
    reload: action
  state filter = "all"
  state choosing = false
  derive shown = filter == "paid" ? invoices.filter(invoice => invoice.paid) : filter == "unpaid" ? invoices.filter(invoice => not invoice.paid) : filter == "overdue" ? invoices.filter(invoice => overdue(invoice, today)) : invoices
  action pickFilter(value: string)
    filter = value
    choosing = false
  action openFilters
    choosing = not choosing
  view
    column navigationKey=`${route}` navigationScroll="invoices-list" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center"
        text "Invoices" role="heading" aria-level=1 flex=1
        button press=openDetails aria-label="Your details" testId="open-details"
          image "symbol:person"
        if hasClients
          button press=add aria-label="New Invoice" testId="add-invoice"
            image "symbol:add"
      if broke
        EmptyState(symbol="symbol:alert", title="Can't Open Invoices", message="Something went wrong reading them.")
          Button(label="Try Again", variant="primary", size="small", leadingIcon="", trailingIcon="",
            disabled=false, press=reload, buttonId="invoices-retry")
      else if invoices.length == 0 and not loading and not hasClients
        EmptyState(symbol="symbol:people", title="Add a client first", message="An invoice needs someone to pay it. Add a client, then come back.")
          Button(label="Add Client", variant="primary", size="small", leadingIcon="symbol:add", trailingIcon="",
            disabled=false, press=addClient, buttonId="first-client")
      else if invoices.length == 0 and not loading
        EmptyState(symbol="symbol:document", title="No invoices yet", message="Bill a client for your work. It takes a minute.")
          Button(label="New Invoice", variant="primary", size="small", leadingIcon="symbol:add", trailingIcon="",
            disabled=false, press=add, buttonId="empty-add-invoice")
      else
        scroll id="invoices-list" flex=1 min-height=0 overflow-x="hidden" testId="home"
          column padding="4px 20px 32px" gap=14 width="100%" box-sizing="border-box"
            InvoiceStats(invoices=lastYear(invoices, today), today=today, filter=filter, choosing=choosing, pick=pickFilter,
              open=openFilters)
            column border-radius=16 overflow="hidden" background-color="surface.card" -exact-layout-transition="280ms ease"
              if shown.length == 0
                row padding="16px"
                  text (filter == "paid" ? "No paid invoices yet." : filter == "overdue" ? "Nothing overdue. Nice." : "Nothing unpaid. Nice.") color="-exact-secondary-label"
                    testId="filter-empty"
              for inv, index in shown key=inv.id
                link href=path("invoice", inv.id) testId=`invoice-${inv.id}` display="flex" flex-direction="row"
                  align-items="center" gap=10 padding="12px 14px 12px 16px" color="-exact-label" text-decoration="none"
                  border-top-width=(index == 0 ? 0 : 1) border-top-style="solid" border-top-color="surface.separator"
                  column flex=1 min-width=0 gap=2
                    text inv.client.name font-size=17
                    text (inv.paid ? `${inv.number} · Paid ${czDate(inv.paidOn)}` : `${inv.number} · Due ${czDate(inv.due)}`)
                      font="-exact-subheadline" color="-exact-secondary-label"
                  column align-items="flex-end" gap=4
                    text money(inv.total, inv.currency) font-size=17 font-variant-numeric="tabular-nums"
                      testId=`invoice-total-${inv.id}`
                    if inv.paid
                      Badge(label="Paid", tint=some("-exact-system-green"))
                    else if overdue(inv, today)
                      Badge(label="Overdue", tint=some("-exact-system-red"))
                  image "symbol:forward-chevron" color="-exact-tertiary-label" aria-hidden=true

component PartySection
  props
    title: string
    party: Client
    prefix: string
  view
    section
      header
        text title
      row padding-top=10 padding-bottom=10
        column flex=1 min-width=0 gap=2
          text party.name font-weight=600 testId=`${prefix}-name`
          if idLine(party) != ""
            text idLine(party) font="-exact-subheadline" color="-exact-secondary-label"
          if party.street != ""
            text party.street
          if party.zip != "" or party.city != ""
            text [party.zip, party.city].filter(part => part != "").join(" ")

component InvoiceDetail
  props
    route: number
    id: string
    invoices: Invoice[]
    today: string
    loading: bool
    edit: action
    setPaid: action
    share: action
    sharing: bool
    duplicate: action
    duplicating: bool
    askRemove: action
    back: action
  view
    column navigationKey=`${route}` navigationScroll=`invoice-${route}` position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center"
        text (invoiceFound(invoices, id) or loading ? `Invoice ${invoiceOf(invoices, id).number}` : "Not Found")
          role="heading" aria-level=2 testId="invoice-title"
        if invoiceFound(invoices, id)
          button press=share disabled=sharing aria-label="Share PDF" testId="share-invoice"
            image "symbol:share"
          button press=edit testId="edit-invoice"
            text "Edit"
      if invoiceFound(invoices, id) or loading
        list id=`invoice-${route}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
          for inv in invoices.filter(candidate => candidate.id == id) key=inv.id
            section
              row
                text "Total"
                text money(inv.total, inv.currency) font="-exact-title2" font-weight=700 color="-exact-label" font-variant-numeric="tabular-nums" testId="invoice-total"
              row
                text "Paid"
                input type="checkbox" switch checked=inv.paid change=setPaid aria-label="Paid" testId="paid-switch"
              footer
                text (inv.paid ? `Paid on ${czDate(inv.paidOn)}.` : overdue(inv, today) ? `Overdue since ${czDate(inv.due)}.` : `Due ${czDate(inv.due)}.`)
                  color=(overdue(inv, today) ? "-exact-system-red" : "-exact-secondary-label") testId="invoice-status"
            PartySection(title="Bill to", party=inv.client, prefix="bill-to")
            section
              header
                text "Items"
              for line, index in inv.items key=index
                row padding-top=6 padding-bottom=6
                  column flex=1 min-width=0 gap=2
                    text line.description
                    text `${line.quantity} × ${money(line.unitPrice, inv.currency)}` font="-exact-subheadline" color="-exact-secondary-label"
                  text money(round(line.quantity * line.unitPrice), inv.currency) font-variant-numeric="tabular-nums"
            section
              row
                text "Issued"
                text czDate(inv.issued) testId="invoice-issued"
              row
                text "Due"
                text czDate(inv.due) testId="invoice-due"
              row
                text "Language"
                text languageName(inv.language) testId="invoice-language"
            section
              header
                text "Payment"
              if inv.account != ""
                row
                  text "Account"
                  text inv.account testId="invoice-account"
                if inv.bankName != ""
                  row
                    text "Bank"
                    text inv.bankName testId="invoice-bank"
                if inv.iban != ""
                  row
                    text "IBAN"
                    text inv.iban font-variant-numeric="tabular-nums" testId="invoice-iban"
                if inv.bic != ""
                  row
                    text "SWIFT"
                    text inv.bic testId="invoice-bic"
              else
                row
                  text "Account"
                  text "None" color="-exact-secondary-label" testId="invoice-account"
              row
                text "Variable symbol"
                text variableSymbol(inv.number) font-variant-numeric="tabular-nums" testId="invoice-vs"
              footer
                text (inv.account != "" ? "Printed on the PDF so the client knows where to pay." : `Add a ${inv.currency} bank account in Your details, then edit and save this invoice.`)
            PartySection(title="From", party=inv.supplier, prefix="from")
            section
              button press=duplicate disabled=duplicating testId="duplicate-invoice"
                text "Duplicate Invoice"
              button press=askRemove destructive=true testId="delete-invoice"
                text "Delete Invoice"
      else
        EmptyState(symbol="symbol:alert", title="No such invoice", message="It may have been deleted.")
          Button(label="Back to Invoices", variant="primary", size="small", leadingIcon="", trailingIcon="",
            disabled=false, press=back, buttonId="missing-invoice-back")

component InvoiceForm
  props
    route: number
    isNew: bool
    clients: Client[]
    invoice: Invoice
    bankAccounts: BankAccount[]
    today: string
    saving: bool
    cancel: action
    save: action
  state clientId = isNew ? (clients.length == 1 ? match clients.at(0) { case some(client) => client.id, case none => "" } : "") : invoice.client.id
  state currency = isNew ? (clients.length == 1 ? match clients.at(0) { case some(client) => client.currency, case none => "CZK" } : "CZK") : invoice.currency
  state issued = isNew ? today : invoice.issued
  state dueDays = isNew ? 14 : invoice.dueDays
  state language = isNew ? (clients.length == 1 ? match clients.at(0) { case some(client) => client.currency == "CZK" ? "cs" : "en", case none => "cs" } : "cs") : invoice.language
  state items = invoice.items.length == 0 ? [blankItem(0)] : invoice.items.map((line, position) => toDraft(line, position))
  state nextKey = invoice.items.length + 1
  derive lines = items.filter(draft => itemFilled(draft))
  derive total = draftTotal(items)
  derive payTo = accountFor(bankAccounts, currency)
  derive saveHint = saving ? "Saving…" : clientId == "" ? "Choose a client to save." : lines.length == 0 ? "Add an item to save." : lines.filter(draft => not itemValid(draft)).length > 0 ? "Give each item a description and a price to save." : issued == "" ? "Choose the issue date to save." : ""

  action pickClient(value: string)
    clientId = value
    if value != ""
      currency = clientOf(clients, value).currency
      language = clientOf(clients, value).currency == "CZK" ? "cs" : "en"
  action pickCurrency(value: string)
    currency = value
  action setIssued(value: string)
    issued = value
  action pickLanguage(value: string)
    language = value
  action pickDueDays(value: string)
    dueDays = amount(value)
  action editDesc(index: number, value: string)
    items = items.map((draft, position) => position == index ? DraftItem(draft, description=value) : draft)
  action editQty(index: number, value: string)
    items = items.map((draft, position) => position == index ? DraftItem(draft, quantity=value) : draft)
  action editPrice(index: number, value: string)
    items = items.map((draft, position) => position == index ? DraftItem(draft, price=value) : draft)
  action addItem
    items = items.concat([blankItem(nextKey)])
    nextKey = nextKey + 1
  action removeItem(index: number)
    if items.length > 1
      items = items.filter((draft, position) => position != index)
  action advance
  action done
    blur()
  action submit
    if saveHint == ""
      save(clientId, issued, dueDays, lines.map(draft => toItem(draft)), currency, language)

  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll=`invoice-form-${route}` position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between"
        button id="back" press=cancel aria-label="Cancel" testId="invoice-cancel"
          image "symbol:close"
        text (isNew ? "New Invoice" : "Edit Invoice") role="heading"
        button press=submit buttonStyle="bordered-prominent" aria-label="Save" disabled=(saveHint != "") testId="invoice-save"
          image "symbol:checkmark"
      scroll id=`invoice-form-${route}` flex=1 min-height=0 keyboardDismissMode="on-drag" overflow-x="hidden"
        column padding="16px 20px 32px" gap=24 width="100%" box-sizing="border-box"
          FieldFrame(label="Client")
            button popovertarget="client-menu" aria-label="Client" testId="i-client" flex=1 min-width=0 height=52
              color="control.ink" text-align="start"
              row align-items="center" gap=8 width="100%" height="100%"
                text (clientId == "" ? "Choose a client" : clientOf(clients, clientId).name) flex=1 min-width=0
                  font-size=17 color=(clientId == "" ? "control.placeholder" : "control.ink")
                image "symbol:chooser" color="control.hint" aria-hidden=true
            column id="client-menu" popover="auto" role="menu" aria-label="Client"
              for client in clients key=client.id
                button role="menuitemradio" aria-checked=(client.id == clientId) press=pickClient(client.id)
                  popovertarget="client-menu" popovertargetaction="hide" testId=`i-client-${client.id}`
                  text client.name
                  text client.currency
          FieldFrame(label="Issued")
            input type="date" value=issued change=setIssued aria-label="Issued" testId="i-issued"
          FormSection(title="Currency",
            footer=(payTo != "" ? `Paid to ${payTo}.` : `You have no ${currency} bank account yet. Add one in Your details, or the invoice goes out without one.`),
            footerTone=(payTo != "" ? "muted" : "warning"))
            CurrencyChoice(value=currency, pick=pickCurrency, testPrefix="i-currency")
          FormSection(title="Due", footer=`Payment is due ${dueDays} ${dueDays == 1 ? "day" : "days"} after the issue date.`,
            footerTone="muted")
            Segmented(label="Due in", choices=[7, 14, 30].map(days => Choice(value=`${days}`, label=`${days} days`)),
              value=`${dueDays}`, pick=pickDueDays, testPrefix="due")
          FormSection(title="Invoice language", footer=(language == "en" ? "The PDF is in English." : "The PDF is in Czech."),
            footerTone="muted")
            Segmented(label="Invoice language", choices=["cs", "en"].map(code => Choice(value=code, label=languageName(code))),
              value=language, pick=pickLanguage, testPrefix="language")
          for draft, index in items key=draft.key
            FormSection(title=(items.length > 1 ? `Item ${index + 1}` : "Item"),
              footer=(itemFilled(draft) and not itemValid(draft) and draft.price.trim() != "" ? "Add a description, a quantity above 0 and a price." : ""),
              footerTone="error")
              TextField(label="Description", value=draft.description, placeholder="App development", hint="", hintTone="muted",
                invalid=false, edit=editDesc(index), submit=advance, fieldId=`item-desc-${index}`,
                keyboard="text", autocomplete="off", autocapitalize="sentences", enterkeyhint="next", maxlength=200,
                autofocus=false)
              row gap=12
                column flex=1 min-width=0
                  TextField(label="Quantity", value=draft.quantity, placeholder="1", hint="", hintTone="muted", invalid=false,
                    edit=editQty(index), submit=advance, fieldId=`item-qty-${index}`, keyboard="decimal",
                    autocomplete="off", autocapitalize="none", enterkeyhint="next", maxlength=10, autofocus=false)
                column flex=2 min-width=0
                  TextField(label="Unit price", value=draft.price, placeholder="0", hint="", hintTone="muted", invalid=false,
                    edit=editPrice(index), submit=done, fieldId=`item-price-${index}`, keyboard="decimal", autocomplete="off",
                    autocapitalize="none", enterkeyhint="done", maxlength=14, autofocus=false)
                    text currencySymbol(currency) color="control.hint" padding-right=8
              row align-items="center" gap=12
                text "Amount" color="control.hint" flex=1
                text money(itemHellers(draft), currency) font-weight=700 font-variant-numeric="tabular-nums" color="control.ink"
                  testId=`item-amount-${index}`
              if items.length > 1
                Button(label="Remove Item", variant="danger", size="small", leadingIcon="symbol:delete", trailingIcon="",
                  disabled=false, press=removeItem(index), buttonId=`remove-item-${index}`)
          Button(label="Add Item", variant="secondary", size="large", leadingIcon="symbol:add", trailingIcon="",
            disabled=false, press=addItem, buttonId="add-line")
          row align-items="center" gap=12 padding="16px" border-radius=16 background-color="control.fill" box-sizing="border-box"
            text "Total" font-size=17 font-weight=600 color="control.ink" flex=1
            text money(total, currency) font-size=22 font-weight=800 font-variant-numeric="tabular-nums" color="control.ink"
              testId="i-total"
          if saveHint != ""
            text saveHint font-size=13 color="control.hint" testId="i-save-hint"

keyframes statEnter
  from opacity=0 translate="0px -10px"

keyframes statFade
  to opacity=0

component InvoiceStats
  props
    invoices: Invoice[]
    today: string
    filter: string
    choosing: bool
    pick: action
    open: action
  derive unpaid = invoices.filter(invoice => not invoice.paid)
  derive paid = invoices.filter(invoice => invoice.paid)
  derive late = unpaid.filter(invoice => overdue(invoice, today))
  derive items = [StatItem(key="all", label="All", count=invoices.length, amounts=amountsLine(invoices), late=0, symbol="symbol:icon.invoices", tint="stat.all", wash="stat.all-wash"), StatItem(key="unpaid", label="Unpaid", count=unpaid.length, amounts=amountsLine(unpaid), late=0, symbol="symbol:icon.unpaid", tint="stat.unpaid", wash="stat.unpaid-wash"), StatItem(key="overdue", label="Overdue", count=late.length, amounts=amountsLine(late), late=0, symbol="symbol:alert-fill", tint="stat.overdue", wash="stat.overdue-wash"), StatItem(key="paid", label="Paid", count=paid.length, amounts=amountsLine(paid), late=0, symbol="symbol:icon.paid", tint="stat.paid", wash="stat.paid-wash")]
  derive shown = items.filter(item => choosing or item.key == filter)
  action tapStat(key: string)
    if choosing
      pick(key)
    else
      open()
  view
    column gap=8
      column role=(choosing ? "radiogroup" : "group") aria-label="Show invoices" testId="stat-choices"
        for item, index in shown key=item.key
          column animation=(choosing and item.key != filter ? "statEnter 240ms ease-out both" : "none")
            -exact-layout-transition="260ms ease" -exact-exit-animation="statFade 140ms ease-in both"
            Stat(item=item, selected=(item.key == filter), collapsed=(not choosing), top=topRadius(index),
              bottom=bottomRadius(index, shown.length), press=tapStat(item.key), testPrefix=`stat-${item.key}`)
      text (choosing ? "Pick what the list shows." : "Last 12 months, by issue date. Tap to change the filter.")
        font="-exact-footnote" color="-exact-secondary-label" padding="0 4px" testId="stats-period"
        -exact-layout-transition="260ms ease"

component Stat
  props
    item: StatItem
    selected: bool
    collapsed: bool
    top: number
    bottom: number
    press: action
    testPrefix: string
  view
    button role=(collapsed ? "button" : "radio") aria-checked=selected aria-expanded=(not collapsed) press=press
      testId=testPrefix width="100%" min-width=0 height=72 padding="0 14px" box-sizing="border-box"
      border-top-left-radius=top border-top-right-radius=top border-bottom-left-radius=bottom
      border-bottom-right-radius=bottom
      border-width=2 border-style="solid" border-color=(selected ? item.tint : "transparent") background-color=item.wash
      color="-exact-label" text-align="start"
      :active
        opacity=1
      row width="100%" height="100%" gap=12 align-items="center"
        column width=44 height=44 border-radius=22 background-color=item.wash align-items="center" justify-content="center"
          image item.symbol color=item.tint width=24 height=24 aria-hidden=true
        column flex=1 min-width=0 gap=2
          row gap=6 align-items="baseline"
            text `${item.count}` font="-exact-title2" font-weight=800 color=item.tint font-variant-numeric="tabular-nums"
              aria-label=invoiceCount(item.count) testId=`${testPrefix}-count`
            text item.label font="-exact-subheadline" font-weight=600 color="-exact-label" white-space="nowrap"
            row flex=1
            if item.late > 0
              text `· ${item.late} overdue` font="-exact-caption1" font-weight=700 color="stat.unpaid" white-space="nowrap"
                testId=`${testPrefix}-note`
          text item.amounts font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
            white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId=`${testPrefix}-amount`
        if collapsed
          image "symbol:chooser" color="-exact-secondary-label" aria-hidden=true
