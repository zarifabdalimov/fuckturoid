use Badge, EmptyState from "exact:content"
use Client, Invoice, DraftItem, kc, czDate, overdue, invoiceOf, invoiceFound, idLine, itemHellers, itemValid, itemFilled from "../model/model.contract"
use blankItem, draftTotal, toItem, toDraft from "../model/model.contract"

component InvoiceList
  props
    route: number
    invoices: Invoice[]
    hasClients: bool
    today: string
    loading: bool
    broke: bool
    openDetails: action
    add: action
    addClient: action
    reload: action
  view
    column navigationKey=`${route}` navigationScroll="invoices-list" position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center"
        text "Invoices" role="heading" aria-level=1 flex=1
        button press=openDetails aria-label="Your details" testId="open-details"
          image "symbol:person"
        if hasClients
          button press=add aria-label="New Invoice" testId="add-invoice"
            image "symbol:add"
      if broke
        EmptyState(symbol="symbol:alert", title="Can't Open Invoices", message="Something went wrong reading them.")
          button press=reload testId="invoices-retry"
            text "Try Again"
      else if invoices.length == 0 and not loading and not hasClients
        EmptyState(symbol="symbol:people", title="Add a client first", message="An invoice needs someone to pay it. Add a client, then come back.")
          button press=addClient testId="first-client"
            text "Add Client"
      else if invoices.length == 0 and not loading
        EmptyState(symbol="symbol:document", title="No invoices yet", message="Bill a client for your work. It takes a minute.")
          button press=add testId="empty-add-invoice"
            text "New Invoice"
      else
        list id="invoices-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="home"
          section
            for inv in invoices key=inv.id
              link href=path("invoice", inv.id) testId=`invoice-${inv.id}`
                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                  text inv.client.name
                  text (inv.paid ? `${inv.number} · Paid ${czDate(inv.paidOn)}` : `${inv.number} · Due ${czDate(inv.due)}`)
                    font="-exact-subheadline" color="-exact-secondary-label"
                column align-items="flex-end" gap=4
                  text kc(inv.total) font-variant-numeric="tabular-nums" testId=`invoice-total-${inv.id}`
                  if inv.paid
                    Badge(label="Paid", tint=some("-exact-system-green"))
                  else if overdue(inv, today)
                    Badge(label="Overdue", tint=some("-exact-system-red"))
                image "symbol:forward-chevron"

component PartySection
  props
    title: string
    party: Client
    prefix: string
  view
    section
      header
        text title
      row padding-top=10 padding-bottom=10
        column flex=1 min-width=0 gap=2
          text party.name font-weight=600 testId=`${prefix}-name`
          if idLine(party) != ""
            text idLine(party) font="-exact-subheadline" color="-exact-secondary-label"
          if party.street != ""
            text party.street
          if party.zip != "" or party.city != ""
            text [party.zip, party.city].filter(part => part != "").join(" ")

component InvoiceDetail
  props
    route: number
    id: string
    invoices: Invoice[]
    today: string
    loading: bool
    edit: action
    setPaid: action
    share: action
    sharing: bool
    askRemove: action
    back: action
  view
    column navigationKey=`${route}` navigationScroll=`invoice-${route}` position="absolute" inset=0
      display="flex" flex-direction="column"
      header display="flex" align-items="center"
        text (invoiceFound(invoices, id) or loading ? `Invoice ${invoiceOf(invoices, id).number}` : "Not Found")
          role="heading" aria-level=2 testId="invoice-title"
        if invoiceFound(invoices, id)
          button press=share disabled=sharing aria-label="Share PDF" testId="share-invoice"
            image "symbol:share"
          button press=edit testId="edit-invoice"
            text "Edit"
      if invoiceFound(invoices, id) or loading
        list id=`invoice-${route}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
          for inv in invoices.filter(candidate => candidate.id == id) key=inv.id
            section
              row
                text "Total"
                text kc(inv.total) font="-exact-title2" font-weight=700 color="-exact-label" font-variant-numeric="tabular-nums" testId="invoice-total"
              row
                text "Paid"
                input type="checkbox" switch checked=inv.paid change=setPaid aria-label="Paid" testId="paid-switch"
              footer
                text (inv.paid ? `Paid on ${czDate(inv.paidOn)}.` : overdue(inv, today) ? `Overdue since ${czDate(inv.due)}.` : `Due ${czDate(inv.due)}.`)
                  color=(overdue(inv, today) ? "-exact-system-red" : "-exact-secondary-label") testId="invoice-status"
            PartySection(title="Bill to", party=inv.client, prefix="bill-to")
            section
              header
                text "Items"
              for line, index in inv.items key=index
                row padding-top=6 padding-bottom=6
                  column flex=1 min-width=0 gap=2
                    text line.description
                    text `${line.quantity} × ${kc(line.unitPrice)}` font="-exact-subheadline" color="-exact-secondary-label"
                  text kc(round(line.quantity * line.unitPrice)) font-variant-numeric="tabular-nums"
            section
              row
                text "Issued"
                text czDate(inv.issued) testId="invoice-issued"
              row
                text "Due"
                text czDate(inv.due) testId="invoice-due"
            PartySection(title="From", party=inv.supplier, prefix="from")
            section
              button press=askRemove destructive=true testId="delete-invoice"
                text "Delete Invoice"
      else
        EmptyState(symbol="symbol:alert", title="No such invoice", message="It may have been deleted.")
          button press=back buttonStyle="filled" testId="missing-invoice-back"
            text "Back to Invoices"

component InvoiceForm
  props
    route: number
    isNew: bool
    clients: Client[]
    invoice: Invoice
    today: string
    saving: bool
    cancel: action
    save: action
  state clientId = isNew ? (clients.length == 1 ? match clients.at(0) { case some(client) => client.id, case none => "" } : "") : invoice.client.id
  state issued = isNew ? today : invoice.issued
  state dueDays = isNew ? 14 : invoice.dueDays
  state items = invoice.items.length == 0 ? [blankItem(0)] : invoice.items.map((line, position) => toDraft(line, position))
  state nextKey = invoice.items.length + 1
  derive lines = items.filter(draft => itemFilled(draft))
  derive total = draftTotal(items)
  derive saveHint = saving ? "Saving…" : clientId == "" ? "Choose a client to save." : lines.length == 0 ? "Add an item to save." : lines.filter(draft => not itemValid(draft)).length > 0 ? "Fix the items marked in red to save." : issued == "" ? "Choose the issue date to save." : ""

  action pickClient(value: string)
    clientId = value
  action setIssued(value: string)
    issued = value
  action setDueDays(days: number)
    dueDays = days
  action editDesc(index: number, value: string)
    items = items.map((draft, position) => position == index ? DraftItem(draft, description=value) : draft)
  action editQty(index: number, value: string)
    items = items.map((draft, position) => position == index ? DraftItem(draft, quantity=value) : draft)
  action editPrice(index: number, value: string)
    items = items.map((draft, position) => position == index ? DraftItem(draft, price=value) : draft)
  action addItem
    items = items.concat([blankItem(nextKey)])
    nextKey = nextKey + 1
  action removeItem(index: number)
    if items.length > 1
      items = items.filter((draft, position) => position != index)
  action submit
    if saveHint == ""
      save(clientId, issued, dueDays, lines.map(draft => toItem(draft)))

  view
    column navigationKey=`${route}` navigationPresentation="modal" navigationScroll=`invoice-form-${route}` position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between"
        button id="back" press=cancel aria-label="Cancel" testId="invoice-cancel"
          image "symbol:close"
        text (isNew ? "New Invoice" : "Edit Invoice") role="heading"
        button press=submit buttonStyle="bordered-prominent" aria-label="Save" disabled=(saveHint != "") testId="invoice-save"
          image "symbol:checkmark"
      list id=`invoice-form-${route}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text "Client"
            select value=clientId change=pickClient aria-label="Client" testId="i-client"
              option "Choose…" value=""
              for client in clients key=client.id
                option client.name value=client.id
          row
            text "Issued"
            input type="date" value=issued change=setIssued aria-label="Issued" testId="i-issued"
        section
          header
            text "Due"
          row role="radiogroup" aria-label="Due in"
            for days in [7, 14, 30] key=days
              button role="radio" aria-checked=(dueDays == days) press=setDueDays(days) testId=`due-${days}` flex=1
                text `${days} ${days == 1 ? "day" : "days"}`
          footer
            text `Payment is due ${dueDays} ${dueDays == 1 ? "day" : "days"} after the issue date.`
        section
          header
            text "Items"
          for draft, index in items key=draft.key
            row delete=removeItem(index) disabled=(items.length <= 1)
              column flex=1 min-width=0 gap=8 padding-top=6 padding-bottom=6
                input value=draft.description input=editDesc(index) placeholder="What you did" aria-label=`Item ${index + 1}`
                  autocapitalize="sentences" testId=`item-desc-${index}`
                row gap=8 align-items="center"
                  input value=draft.quantity input=editQty(index) inputmode="decimal" aria-label=`Item ${index + 1} quantity`
                    width="3.5rem" text-align="end" testId=`item-qty-${index}`
                  text "×" color="-exact-secondary-label"
                  input value=draft.price input=editPrice(index) inputmode="decimal" placeholder="Price" aria-label=`Item ${index + 1} price`
                    flex=1 min-width=0 text-align="end" testId=`item-price-${index}`
                  text "Kč" color="-exact-secondary-label"
                if itemFilled(draft) and not itemValid(draft)
                  text "Add a description, a quantity above 0 and a price." font="-exact-footnote" color="-exact-system-red"
                else
                  text kc(itemHellers(draft)) font="-exact-subheadline" color="-exact-secondary-label" align-self="flex-end"
                    font-variant-numeric="tabular-nums" testId=`item-amount-${index}`
          button press=addItem testId="add-line"
            text "Add Item"
          footer
            text `Total ${kc(total)}` font-weight=600 font-variant-numeric="tabular-nums" testId="i-total"
        if saveHint != ""
          section
            footer
              text saveHint testId="i-save-hint"
